# =============================================================================
# LLMbase Stack
# =============================================================================
#
# Struttura directory attesa:
#   .
#   ├── docker-compose.yml
#   ├── .env                        ← credenziali (non committare!)
#   ├── Dockerfile                  ← llmbase (build locale)            
#   ├── raw/                        ← dati grezzi (non committare!)
#   └── wiki/                       ← dati conioscenza (non committare!)
#
# Avvio:   docker compose up -d
# Logs:    docker compose logs -f llmbase
# =============================================================================
services:
  llmbase:
    build .
    restart: unless-stopped
    ports:
      - 5555:5555
    env_file: .env
    # user: "1000:1000"
    # environment:
    #   HOME: /tmp
    security_opt:
      - no-new-privileges:true
    networks:
      - llmbase-net
    volumes:
      - ./raw:/app/raw
      - ./wiki:/app/wiki
    healthcheck:
      test: ["CMD", "llmbase", "stats"]
      interval: 30s
      timeout: 15s
      retries: 3
      start_period: 20s

networks:
  llmbase-net:
    driver: bridge