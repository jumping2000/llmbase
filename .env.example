# LLMBase — LLM Provider Configuration
# Works with any OpenAI-compatible API: OpenAI, OpenRouter, Ollama, Together, etc.

LLMBASE_API_KEY=sk-your-api-key-here
LLMBASE_BASE_URL=https://api.openai.com/v1
LLMBASE_MODEL=gpt-4o

# ─── Examples ───────────────────────────────────────────────

# --- OpenAI ---
# LLMBASE_API_KEY=sk-...
# LLMBASE_BASE_URL=https://api.openai.com/v1
# LLMBASE_MODEL=gpt-4o

# --- OpenRouter (access 200+ models) ---
# LLMBASE_API_KEY=sk-or-...
# LLMBASE_BASE_URL=https://openrouter.ai/api/v1
# LLMBASE_MODEL=anthropic/claude-sonnet-4-6

# --- Ollama (local, free) ---
# LLMBASE_API_KEY=ollama
# LLMBASE_BASE_URL=http://localhost:11434/v1
# LLMBASE_MODEL=llama3.1

# --- Together AI ---
# LLMBASE_API_KEY=...
# LLMBASE_BASE_URL=https://api.together.xyz/v1
# LLMBASE_MODEL=meta-llama/Llama-3-70b-chat-hf

# --- Groq ---
# LLMBASE_API_KEY=gsk_...
# LLMBASE_BASE_URL=https://api.groq.com/openai/v1
# LLMBASE_MODEL=llama-3.1-70b-versatile

# You can also use the standard OpenAI env vars as fallback:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback models (comma-separated, tried in order if primary fails)
# Empty/unset = NO fallback (only the primary model is retried). This is a
# 0.5.0 change — earlier versions auto-guessed gpt-4o-mini / MiniMax-M2.5,
# which silently broke aggregator deployments where the API token only had
# rights to the primary model. Set this explicitly if you want fallback:
# LLMBASE_FALLBACK_MODELS=deepseek-chat,gpt-4o-mini,glm-4-flash

# Retry budget per role (defaults: primary=3, fallback=1). Bump primary
# higher for aggregators with transient 5xx where retrying the same model
# usually succeeds before falling back is worth it.
# LLMBASE_PRIMARY_RETRIES=3
# LLMBASE_FALLBACK_RETRIES=1

# API Security (optional — if set, write endpoints require this token)
# Leave empty for local/dev use (all endpoints open)
# Recommended when running behind the bundled Nginx Basic Auth proxy.
# LLMBASE_API_SECRET=your-secret-token-here

# Restrict which models a client may request per-request on POST /api/ask.
# Comma-separated list; empty or unset means no restriction. A request naming
# a model outside the list is rejected with 400.
# LLMBASE_MODEL_ALLOWLIST=gpt-4o-mini,anthropic/claude-sonnet-4-6

# MCP (Model Context Protocol) runtime settings
# MCP is served by the unified web app on /mcp (uvicorn asgi:app) — no
# separate service. The only variable needed is the shared secret validated
# by the app via the X-API-Key header:
# MCP_API_KEY=change-me

# ─── Telegram bot (optional) ────────────────────────────────────────
# When LLMBASE_TG_TOKEN is set, the web app starts a long-polling bot
# thread. Only chat ids in the whitelist can talk to it.
# LLMBASE_TG_TOKEN=123456:ABC-DEF...
# LLMBASE_TG_ALLOWED_CHAT_IDS=123456789,987654321
# LLMBASE_TG_DEFAULT_DOMAIN=generale

# ─── Email ingestion via IMAP (optional) ────────────────────────────
# When LLMBASE_MAIL_HOST/USER/PASSWORD are set, the web app starts an
# IMAP poller. Subject tag [dominio] routes the message to a domain;
# unknown tags fall back to LLMBASE_MAIL_DEFAULT_DOMAIN.
# LLMBASE_MAIL_HOST=imap.example.com
# LLMBASE_MAIL_PORT=993
# LLMBASE_MAIL_USER=wiki@example.com
# LLMBASE_MAIL_PASSWORD=your-password
# LLMBASE_MAIL_FOLDER=INBOX
# LLMBASE_MAIL_PROCESSED_FOLDER=Processed
# LLMBASE_MAIL_POLL_MINUTES=1
# LLMBASE_MAIL_DEFAULT_DOMAIN=generale

# ─── Tuning (optional) ──────────────────────────────────────────────
# Timeouts for outbound LLM HTTP calls, in seconds. Raise the read timeout
# for local Ollama or slow GPUs; CONNECT covers the TCP/TLS handshake only.
# LLMBASE_HTTP_TIMEOUT=300
# LLMBASE_HTTP_CONNECT_TIMEOUT=30

# Cache-Control max-age for GET /api/articles/lite, in seconds.
# Default 0 = no caching. Negative or non-numeric values fall back to 0.
# LLMBASE_LITE_CACHE_MAX_AGE=0

# Absolute path to an alternative .env file. When set it is authoritative:
# if the file is missing or unreadable, llmbase refuses to fall back to any
# other .env location rather than silently loading a different one.
# LLMBASE_ENV_FILE=/etc/llmbase/env
